# Application
APP_NAME=HandoverOS
APP_VERSION=1.0.0
DEBUG=false
SECRET_KEY=replace-with-a-long-random-secret

# PostgreSQL
POSTGRES_DB=handoveros
POSTGRES_USER=handoveros
POSTGRES_PASSWORD=change-this-password

# Database connection (Docker Compose service name: db)
DATABASE_URL=postgresql+psycopg://handoveros:change-this-password@db:5432/handoveros

# API
API_PREFIX=/api
CORS_ORIGINS=http://localhost:3000

# Optional integrations
OPENAI_API_KEY=
GITHUB_TOKEN=
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/handoveros

# Local LLM Configuration
LLM_PROVIDER=ollama
LLM_MODEL=qwen3.5:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Intelligence Engine Configuration
LLM_TEMPERATURE=0.1
LLM_MAX_INPUT_CHARACTERS=100000
LLM_MAX_SOURCES_PER_BATCH=25
LLM_MAX_CLAIMS_PER_SOURCE=30
LLM_MAX_OUTPUT_TOKENS=4000
LLM_REQUEST_TIMEOUT=120